{
  "rules": {
    "codigosActivacion": {
      ".read": "auth != null",
      ".write": false
    },
    "userAlarma": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()"
      }
    },
    "alarmas": {
      "$alarmaId": {
        "adminUid": {
          ".read": "auth != null && root.child('userAlarma').child(auth.uid).val() === $alarmaId",
          ".write": "auth != null && root.child('userAlarma').child(auth.uid).val() === $alarmaId && !data.exists()"
        },
        "usuarios": {
          ".read": "auth != null",
          ".write": false,
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('alarmas').child($alarmaId).child('adminUid').val() === auth.uid)"
          }
        },
        "dispositivoUid": {
          ".read": "auth != null && root.child('userAlarma').child(auth.uid).val() === $alarmaId",
          ".write": false
        },
        "historial": {
          ".read": "auth != null && root.child('userAlarma').child(auth.uid).val() === $alarmaId",
          ".write": "auth != null && (root.child('userAlarma').child(auth.uid).val() === $alarmaId || root.child('alarmas').child($alarmaId).child('dispositivoUid').val() === auth.uid)"
        }
      }
    }
  }
}
